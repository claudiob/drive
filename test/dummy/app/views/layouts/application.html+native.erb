<!DOCTYPE html>
<html lang='en'>
  <head>
    <meta charset='utf-8'>
    <%# Read by Hotwire Native for the navigation bar's title, so every screen sets it. %>
    <title><%= content_for(:title) || 'Drive' %></title>
    <%# viewport-fit=cover is load-bearing: without it every env(safe-area-inset-*)
        evaluates to zero and nothing clears the tab bar or the home indicator. %>
    <meta name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover'>
    <meta name='color-scheme' content='light dark'>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# No Bootstrap and no webfont here. This shell follows Apple's HIG, not the
        admin console's, and the system font is the one the platform draws with. %>
    <link rel='stylesheet' href='/native/base.css'>
    <link rel='stylesheet' href='/native/lists.css'>

    <%# Upstream's bridge bundle imports Stimulus by the bare '@hotwired/stimulus'
        specifier, which a browser cannot resolve on its own — the module would fail to
        load and take the bridge with it. Mapped here rather than edited there, so the
        vendored copy stays byte-identical to what npm serves. Must precede any module. %>
    <script type='importmap'>
      { "imports": { "@hotwired/stimulus": "/recourse/stimulus.js" } }
    </script>

    <script type='module'>
      import { Application } from '/recourse/stimulus.js'
      import NavButtonsController from '/native/nav_buttons_controller.js'

      // Guarded and in the head, the way the gem's own layout does it: Turbo re-runs
      // body scripts on every visit, and a second application would connect every
      // controller twice.
      if (!window.Stimulus) {
        window.Stimulus = Application.start()
        window.Stimulus.register('nav-buttons', NavButtonsController)
      }
    </script>
  </head>

  <body>
    <main class='screen'><%= yield %></main>

    <script type='module' src='https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.23/dist/turbo.es2017-esm.js'></script>
  </body>
</html>
