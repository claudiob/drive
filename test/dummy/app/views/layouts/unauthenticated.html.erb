<!DOCTYPE html>
<html lang='en'>
  <head>
    <meta charset='utf-8'>
    <title><%= content_for(:title) || 'Recourse' %></title>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel='stylesheet' href='/recourse/bootstrap.min.css'>
  </head>

  <%# No breadcrumb and no sidebar. Both are for a recourse, and they would raise %>
  <%# here: the breadcrumb links to this controller's index, which does not exist. %>
  <body class='d-flex flex-column min-vh-100'>
    <main class='container-fluid py-4 px-3'>
      <%= yield %>
    </main>
  </body>
</html>
