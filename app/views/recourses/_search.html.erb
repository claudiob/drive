<%# locals: (query:, url:, field:, prompt:, filters:, sort:) -%>
<%# `turbo-permanent`: a refresh broadcast morphs the page, and idiomorph would
    write the fetched page's older query over what is being typed — skipping the
    form keeps the text, the caret and any open filter menu. The id is what the
    classic permanent-element path matches under a replace render. -%>
<%= search_form_for query, url: url, html: { id: 'search',
                                            class: 'recourse-search d-flex flex-wrap md:flex-nowrap ' \
                                                   'align-items-center justify-content-end gap-2 ms-auto',
                                            role: 'search',
                                            data: { controller: 'search', turbo_frame: :results,
                                                    turbo_permanent: '' } } do |form| %>
  <%# Always drawn, even empty: a heading clicked after this was rendered has only
      this field to write the new sort into. -%>
  <%= hidden_field_tag 'q[s]', sort %>

  <% filters.each do |predicate, options| -%>
    <%= filter_field predicate, **options %>
  <% end -%>

  <div class='recourse-search-box form-control form-control-sm form-adorn d-flex'>
    <span class='form-adorn-icon'><i class='bi bi-search'></i></span>
    <%= form.search_field field, class: 'form-ghost', placeholder: prompt, aria: { label: prompt },
                                 data: { action: 'input->search#submit', search_target: 'field' } %>
  </div>
<% end %>
