<% record = local_assigns[resource_key] -%>
<%= form_with model: record do |form| %>
  <% @recourse_form = form -%>
  <div class='row'>
    <%= render 'fields', resource_key => record %>
  </div>

  <%# Hidden rather than dropped in a native shell: the navigation bar's Save button %>
  <%# works by clicking this one, and mirrors its disabled state while submitting. %>
  <%= form.submit class: "btn btn-solid theme-primary#{' native-hidden' if native_shell?}" %>
<% end %>
