<% record = local_assigns[resource_key] -%>
<%= form_with model: record do |form| %>
  <div class='row'>
    <% editable_columns.each do |name| %>
      <div class='mb-3 lg:col-6'>
        <%= form.label name, resource_column_title(name), class: 'form-label' %>
        <%= resource_field form, name %>
      </div>
    <% end %>
  </div>

  <%= form.submit class: 'btn btn-solid theme-primary' %>
<% end %>
