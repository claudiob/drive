<%# locals: (recourses:, pagy:) %>
<% cache recourses do %>
  <div class='table-responsive'>
    <table class='table caption-top table-hover align-middle sm:table-stacked'>
      <thead>
        <tr>
          <% @recourse_headers = true %>
          <%= render 'row', resource_key => nil %>
          <%= column header: 'Actions' %>
        </tr>
      </thead>
      <tbody>
        <% @recourse_headers = false %>
        <% recourses.each do |recourse| %>
          <tr>
            <%= render 'row', resource_key => recourse %>
            <%= column header: 'Actions' do %><%= edit_resource_link recourse %><% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if pagy %>
  <%# Stacked below 576px and a row above it: the count and a nine-item series do not %>
  <%# share 375px, and this pair sits outside `.table-responsive`, so anything too %>
  <%# wide here scrolls the page itself rather than the table. `flex-wrap` covers the %>
  <%# narrowest case, where the series alone is wider than the screen. %>
  <div class='d-flex flex-column sm:flex-row align-items-center gap-2'>
    <div class='ps-2 sm:flex-grow-1'><%== pagy.info_tag.gsub(/of (\d*?) in total/) { "of #{number_with_delimiter $1} in total" } %></div>
    <div class='pe-2'><%== pagy.series_nav(:bootstrap, classes: 'pagination flex-wrap justify-content-center mb-0') if pagy.last > 1 %></div>
  </div>
<% end %>
