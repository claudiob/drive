<%# locals: (resources:, pagy:) %>

<% columns = resource_columns %>

<div class='table-responsive'>
  <table class='table table-hover'>
    <thead>
      <tr>
        <% columns.each do |column| %>
          <th scope='col'><%= resource_column_title column %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% resources.each do |resource| %>
        <tr>
          <% columns.each do |column| %>
            <td><%= resource.public_send column %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%== pagy.info_tag %>
<%== pagy.series_nav :bootstrap %>
