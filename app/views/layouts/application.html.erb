<!DOCTYPE html>
<html lang='en'>
  <head>
    <meta charset='utf-8'>
    <title><%= content_for(:title) || 'Recourse' %></title>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel='preconnect' href='https://fonts.googleapis.com'>
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
    <link rel='stylesheet'
          href='https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap'>
    <link rel='stylesheet'
          href='https://v6-dev--twbs-bootstrap.netlify.app/docs/6.0/dist/css/bootstrap.min.css'>
    <link rel='stylesheet'
          href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css'>

    <style>
      :root {
        --bs-body-font-family: 'Geist', system-ui, sans-serif;
        --bs-font-mono: 'Geist Mono', ui-monospace, monospace;
      }
    </style>
  </head>

  <body class='d-flex flex-column min-vh-100'>
    <nav class='navbar border-bottom'>
      <div class='container-fluid px-3 justify-content-start'>
        <%= render 'breadcrumb' %>
        <%= yield :actions %>
      </div>
    </nav>

    <div class='container-fluid flex-grow-1 d-flex'>
      <div class='row flex-grow-1'>
        <aside class='col-auto border-end py-3 px-3 mx-0'>
          <%= render 'sidebar' %>
        </aside>

        <main class='col py-4 px-3'>
          <%= yield %>
        </main>
      </div>
    </div>

    <script type='module'
            src='https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.23/dist/turbo.es2017-esm.js'></script>
    <script type='module'
            src='https://v6-dev--twbs-bootstrap.netlify.app/docs/6.0/dist/js/bootstrap.bundle.min.js'></script>
  </body>
</html>
