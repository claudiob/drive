<%# Three things below are for a native shell and pointless without one, so they %>
<%# travel together: the safe-area stylesheet, the viewport that makes its insets %>
<%# measurable, and the class that spends them. `viewport-fit=cover` on its own %>
<%# would let content under the status bar with nothing holding it clear. %>
<% native = defined? RubyNative -%>
<% in_app = native && native_app? -%>
<!DOCTYPE html>
<html lang='en'>
  <head>
    <meta charset='utf-8'>
    <title><%= content_for(:title) || 'Recourse' %></title>
    <meta name='viewport' content='width=device-width, initial-scale=1<%= ', viewport-fit=cover' if native %>'>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel='preconnect' href='https://fonts.googleapis.com'>
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
    <link rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap'>
    <link rel='stylesheet' href='/recourse/bootstrap.min.css'>
    <link rel='stylesheet' href='/recourse/bootstrap-icons.min.css'>
    <%= stylesheet_link_tag :ruby_native if native %>

    <script type='module'>
      import { Application } from '/recourse/stimulus.js'
      import PhoneController from '/recourse/phone_controller.js'

      // In the head, and guarded: Turbo re-runs body scripts on every visit, and a
      // second application would connect every controller twice.
      if (!window.Stimulus) {
        window.Stimulus = Application.start()
        window.Stimulus.register('phone', PhoneController)
      }
    </script>

    <style>
      :root {
        --bs-body-font-family: 'Geist', system-ui, sans-serif;
        --bs-font-mono: 'Geist Mono', ui-monospace, monospace;
      }
    </style>
  </head>

  <body class='d-flex flex-column min-vh-100'>
    <%# In a native shell both of these are already there, natively: the navigation %>
    <%# bar carries the title and the back button, and the tab bar carries the links %>
    <%# the sidebar would. Rendering them again would only duplicate them. %>
    <% unless in_app %>
      <nav class='navbar border-bottom'>
        <div class='container-fluid px-3 justify-content-start'>
          <%= render 'breadcrumb' %>
          <%= yield :actions %>
        </div>
      </nav>
    <% end %>

    <div class='container-fluid flex-grow-1 d-flex'>
      <div class='row flex-grow-1'>
        <% unless in_app %>
          <aside class='col-auto border-end py-3 px-3 mx-0'>
            <%= render 'sidebar' %>
          </aside>
        <% end %>

        <%# The native navigation bar is translucent, so without this the first row %>
        <%# of the page reads through it. The inset is exactly the bar's height. %>
        <main class='col py-4 px-3<%= ' native-inset-top' if in_app %>'>
          <%= yield %>
        </main>
      </div>
    </div>

    <%# Tells a native shell to show its tab bar on this page: the config lists the %>
    <%# tabs, this asks for them. Guarded because the helper only exists in a host %>
    <%# that has ruby_native, and most hosts do not. %>
    <%= native_tabs_tag if respond_to? :native_tabs_tag %>

    <%# Titles the native navigation bar after the page, in plain text with no icon. %>
    <%# It reads `content_for :title` here rather than in the index template so a %>
    <%# host that writes its own index still gets a titled bar. Pull to refresh comes %>
    <%# with the bar — it is on unless a page passes `pull_to_refresh: false`. %>
    <%= native_navbar_tag content_for(:title) if in_app && controller.action_name == 'index' %>

    <%= render 'flash' %>

    <script type='module' src='https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.23/dist/turbo.es2017-esm.js'></script>
    <script type='module' src='/recourse/bootstrap.bundle.min.js'></script>
    <script type='module'>
      import { Toast } from '/recourse/bootstrap.bundle.min.js'

      // A toast stays hidden until shown, and only then starts its autohide timer.
      for (const toast of document.querySelectorAll('.toast')) Toast.getOrCreateInstance(toast).show()
    </script>
  </body>
</html>
