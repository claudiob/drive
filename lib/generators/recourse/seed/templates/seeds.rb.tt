# <%= Recourse::Generators::Rows::ROWS %> <%= @model.model_name.plural.humanize.downcase %>: the first carries only what a row
# cannot save without, the last fills every attribute, and the rest mix which
# optional attributes are filled. The values are of each column's own type and
# nothing more — a validator this model has grown will have opinions about them.
#
# `find_or_create_by!` throughout, so seeding twice finds these rows rather than
# making them again.
[
<% seed_rows.each do |row| -%>
  { <%= row %> },
<% end -%>
].each { |attributes| <%= @model.name %>.find_or_create_by! attributes }
